{
  "name": "cloud-accounts",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud Accounts desktop client for Codex usage and login management.",
  "homepage": "https://github.com/AnThophicous/cloud-accounts",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnThophicous/cloud-accounts.git"
  },
  "author": {
    "name": "AnThophicous",
    "email": "resumindoanimes60@gmail.com"
  },
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite --port 4173\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:4173 dist-electron/main/main.js dist-electron/preload.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@fontsource/aldrich": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/montserrat": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "boxicons": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.542.0",
    "motion": "^12.40.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.cloudaccounts.app",
    "productName": "Cloud Accounts",
    "directories": {
      "output": "release"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "logo.png"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "AnThophicous <resumindoanimes60@gmail.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
